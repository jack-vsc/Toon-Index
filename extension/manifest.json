{
  "manifest_version": 3,
  "name": "Manga Index – marcador de leitura",
  "version": "0.1.0",
  "description": "Avisa o Manga Index dos capítulos de mangá e webtoon que você lê, para ele lembrar onde você parou.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:47321/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Manga Index" }
}
